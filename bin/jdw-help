    CMD_RADI="/usr/bin/jdw-radio"
    CMD_META="/usr/bin/jdw-metal"
    CMD_I666="/usr/bin/jdw-ic666"

    if [ -f "$CMD_MEGR" ] || [ -f "$CMD_MCPR" ] || [ -f "$CMD_WPHO" ] || [ -f "$CMD_WPAN" ] || [ -f "$CMD_RADI" ] || [ -f "$CMD_META" ] || [ -f "$CMD_I666" ]; then
        echo -e "  $(print_grg "[ JÐWØ®LÐ Ø$: TERMINAL USER INTERFACE ]")"
    fi

    if [ -f "$CMD_MEGR" ]; then
        stampa_voce_allineata_help_orange "jdw-mc" "" "Lancia il JÐWØ®LÐ Ø$ Media-Grabber (Boccaporto Edition)"
    fi

    if [ -f "$CMD_MCPR" ]; then
        stampa_voce_allineata_help_orange "jdw-mcpro" "" "Lancia il JÐWØ®LÐ Ø$ Media Center Pro"
    fi

    if [ -f "$CMD_RADI" ]; then
        stampa_voce_allineata_help_orange "jdw-radio" "" "Ascolta le radio selezionate per il JÐWØ®LÐ Ø$"
    fi

    if [ -f "$CMD_META" ]; then
        stampa_voce_allineata_help_orange "jdw-metal" "" "Ascolta Musica Metal selezionata per il JÐWØ®LÐ Ø$"
    fi

    if [ -f "$CMD_WPAN" ]; then
        stampa_voce_allineata_help_orange "jdw-wp-animate" "" "Lancia lo Switch per i Wallpaper Animati in formato WEBP"
    fi

    if [ -f "$CMD_WPHO" ]; then
        stampa_voce_allineata_help_orange "jdw-wp-horror" "" "Lancia lo Switch per i Wallpaper Horror in formato JPG"
    fi

    if [ -f "$CMD_I666" ]; then
        stampa_voce_allineata_help_orange "jdw-ic666" "" "Lancia Inferno Core 6.6.6, la Suite Infernale del JÐWØ®LÐ Ø$"
    fi

#    if [ -f "$CMD_" ]; then
#        stampa_voce_allineata_help_orange "jdw-" "" ""
#    fi

#        stampa_voce_allineata_help_orange "" "" ""
#        stampa_voce_allineata_help_orange "" "" ""
#        stampa_voce_allineata_help_orange "" "" ""
#        stampa_voce_allineata_help_orange "" "" ""
        echo ""
        print_jdw_bar "$red"
        stampa_voce_allineata_help_red "Q" "Exit" "Uscita da JÐWØ®LÐ Ø$: MANUAL HELP"
        echo ""

    # Prompt interattivo testuale esteso (Accetta comandi completi o sigle)
    echo -ne "${red} 🔥 JÐWØ®LÐ Ø$ ${green}> ${reset} "
    read -r scelta_cmd
    # Normalizzazione dell'input (rimuove spazi vuoti e forza caratteri minuscoli)
    scelta_cmd=$(echo "$scelta_cmd" | tr '[:upper:]' '[:lower:]' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

    [ -z "$scelta_cmd" ] && continue
    if [[ "$scelta_cmd" == "q" || "$scelta_cmd" == "exit" ]]; then exit 0; fi
    done








