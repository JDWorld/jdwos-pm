    while true; do
    clear
        PKG="JDW-HELP"
        stampa_header_stato
        # Il tuo tocco grafico Matteo: Chiamata diretta con gradiente Blu-Bianco-Blu
        jdw_header_dinamico
        print_jdw_bar "$red"
        echo ""
        centra_testo "${dim} TABELLA DEI COMANDI UNIVERSALI JÐWØ®LÐ Ø$ ${reset}"
        # INIEZIONE NELLA VARIABILE DI TESTATA CON I GRADIENTI ED INTEGRITÀ
        echo ""
#        print_jdw_bar "$blued"
        # --- SEZIONE LUIS LEGACY & SYSTEM COMMANDS (L'eredità di Jack sulla barca) ---
        echo -e "  $(print_grg "[ JÐWØ®LÐ Ø$: PACKAGE MANAGER ]")"
        stampa_voce_allineata_help_orange "jdw-install" "" "Lancia l'installatore atomico dei pacchetti JDW"
