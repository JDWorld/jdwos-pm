        stampa_voce_allineata_help_orange "jdw-help" "" "Per vedere questa schermata di aiuto"
        echo ""

# --- IL FILTRO DI CONTROLLO PER LA SUITE FASTFETCH CUSTOM ---
# 1. Definiamo il percorso del file di configurazione master di JDWorld OS
CONF_FF_HARD="/usr/share/jdworldos/jdwos-stm-ff/fastfetch/jdwos_full.jsonc"
# Puoi usare anche il percorso nella home se preferisci: "/home/${SUDO_USER:-$USER}/.config/fastfetch/hardware.jsonc"

# 2. Controllo a doppia mandata: il comando deve esistere E il file deve essere presente
if command -v fastfetch &>/dev/null -a -f "$CONF_FF_HARD"; then
    echo -e "  $(print_rgr "[ JÐWØ®LÐ Ø$: FASTFETCH CUSTOM ]")"
#    echo -e "  ${dim}i comandi compaiono solo se installato il pacchetto jdwos-ff-stm ${reset}"
    # Se entrambi i controlli passano, la TUI sputa i 4 comandi in blocco nel panino Yellow
    stampa_voce_allineata_help_orange "fastfetch" "" "Identikit tecnico (Hardware + Software)"
    stampa_voce_allineata_help_orange "ff-hard" ""  "Ispezione profonda dei componenti fisici e delle temperature"
    stampa_voce_allineata_help_orange "ff-soft" ""  "Resoconto dei pacchetti installati, kernel e librerie globali"
    stampa_voce_allineata_help_orange "ff-stock" "" "Lancio del Fastfetch originale di Arch senza modifiche grafiche"
